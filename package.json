{
  "name": "english-writing-assistant",
  "productName": "English Assist",
  "version": "1.1.0",
  "description": "Assistente de escrita em ingl\u00eas que vive na bandeja do Windows: traduz e refina o texto do clipboard com um atalho global.",
  "main": "./out/main/index.js",
  "author": "Wallace Luis",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "openai": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
